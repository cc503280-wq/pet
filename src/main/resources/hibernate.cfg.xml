<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
  "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
  "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
 <session-factory>

  
  
  <property name="hibernate.dialect">org.hibernate.dialect.SQLServerDialect</property>
  
  <property name="hibernate.show_sql">true</property>
  <property name="hibernate.format_sql">true</property>
  <property name="hibernate.connection.datasource">java:comp/env/jdbc/petDB</property>
  
  
  <property name="hibernate.current_session_context_class">thread</property>
  
  <mapping class="com.pet.model.appointment.Appointment"/>
  <mapping class="com.pet.model.appointment.Employee"/>
  <mapping class="com.pet.model.appointment.PetService"/>
  <mapping class="com.pet.model.appointment.ScheduleBlock"/>
  <mapping class="com.pet.model.appointment.WorkSlot"/>
  <mapping class="com.pet.model.member.MemberPet"/>
  <mapping class="com.pet.model.member.Member"/>
  <mapping class="com.pet.model.member.Coupon"/>
  <mapping class="com.pet.model.member.CouponUsers"/>
  <mapping class="com.pet.model.member.Favorites"/>
  <mapping class="com.pet.model.member.Admin"/>

  
  

 </session-factory>
</hibernate-configuration>